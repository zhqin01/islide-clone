/* iSlide Clone — Global Qt Stylesheet */
/* Modern, clean look inspired by Office Ribbon */

QMainWindow {
    background-color: #f5f5f5;
}

/* Ribbon */
QWidget#ribbon {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d0d0;
}

QTabWidget::pane {
    border: none;
    background: #ffffff;
}

QTabBar::tab {
    background: #f0f0f0;
    color: #444;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2c5f2d;
    border-bottom: 2px solid #2c5f2d;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #e8e8e8;
}

/* Ribbon Groups */
QGroupBox {
    font-weight: bold;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
    background: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #555;
}

/* Buttons */
QPushButton {
    background: #f8f8f8;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 6px 14px;
    font-size: 12px;
    color: #333;
}

QPushButton:hover {
    background: #e3f0e4;
    border-color: #2c5f2d;
}

QPushButton:pressed {
    background: #c8e0c9;
}

QPushButton:disabled {
    background: #f0f0f0;
    color: #999;
}

/* Tool Buttons (icon buttons) */
QToolButton {
    background: #f8f8f8;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}

QToolButton:hover {
    background: #e3f0e4;
    border-color: #2c5f2d;
}

QToolButton:pressed {
    background: #c8e0c9;
}

/* Combo Boxes */
QComboBox {
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #2c5f2d;
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 4px 6px;
    font-size: 12px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #2c5f2d;
}

/* Lists */
QListWidget {
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    font-size: 12px;
}

QListWidget::item:selected {
    background: #2c5f2d;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background: #e3f0e4;
}

/* Status Bar */
QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d0d0d0;
    font-size: 12px;
    color: #555;
    padding: 2px 8px;
}

/* Scroll Bars */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Labels */
QLabel {
    font-size: 12px;
    color: #444;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    text-align: center;
    font-size: 12px;
    height: 20px;
}

QProgressBar::chunk {
    background: #2c5f2d;
    border-radius: 2px;
}
